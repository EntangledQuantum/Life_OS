<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's declaration (UI_SPEC §8.5).

  `minWidth`/`minHeight` are the smallest box the launcher may hand out, not a
  layout size: the layout itself reads `LocalSize.current` and picks a content
  tier from it, so this only has to be small enough to allow the 2x2 tier.

  `updatePeriodMillis` is **0 on purpose**. The platform minimum is 30 minutes
  and it wakes the device to run; this widget is updated by the same
  `SyncWorker` that keeps the app's cache current, and after any widget tick, so
  a second independent schedule would only mean more wake-ups for the same
  content.

  `resizeHorizontal|vertical`, because the whole point of the tier rule is that
  a resize is a normal thing the user does.

  `previewImage` is what the launcher's picker shows before anything is placed.
  Milestone 3 shipped without one and the picker fell back to the app icon,
  which says nothing about what you are about to add to your home screen. From
  API 31 there is something better — `previewLayout`, in `res/xml-v31/`, which
  has the system lay out the real thing — so this drawable is the fallback for
  older launchers (and for OEM pickers that prefer a drawable at any API
  level). It is rendered by `scripts/build-widget-preview.py` and committed; the
  two previews are kept in step by hand.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="140dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="140dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:widgetCategory="home_screen"
    android:previewImage="@drawable/widget_preview"
    android:description="@string/widget_description" />
