<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP, on purpose.

  Life OS runs on the user's own machine and is reached over plain `http://` on
  a LAN or over Tailscale. Android 9+ blocks cleartext by default, and the
  failure mode is vicious: a debug build works (the debug variant permits
  cleartext for you) while a release build fails every request at the socket
  layer with no user-visible cause. The Expo app lost real debugging time to
  exactly this. `adb logcat | grep -i cleartext` is what finally prints it.

  Scoping: the server's address is user-entered and can be any private IPv4
  range, a `.local` mDNS name, or a `*.ts.net` Tailscale name, so the base
  config has to permit cleartext — an allow-list of literal hosts cannot cover
  "whatever the user types". The named domain-configs below exist to document
  the intended reach and to keep the loopback/LAN/Tailscale cases explicit; the
  base config is what actually makes an arbitrary LAN host work.

  This file applies to every build type, which is the point — verify it is in
  the release APK, not just the debug one.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <!--
          System anchors only. User-installed certificates are deliberately NOT
          trusted: nothing in this product needs a self-signed HTTPS server (the
          LAN case is plain HTTP, and a Tailscale or tunnel URL gets a real
          certificate), so trusting the user store would widen the attack surface
          for no feature.
        -->
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Loopback (emulator host, adb reverse) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!-- Tailscale tailnet names and mDNS -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ts.net</domain>
        <domain includeSubdomains="true">local</domain>
    </domain-config>
</network-security-config>
