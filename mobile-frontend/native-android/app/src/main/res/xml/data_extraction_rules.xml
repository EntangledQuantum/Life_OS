<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device. The API token lives in Keystore-backed
  EncryptedSharedPreferences and must never be carried off into a cloud backup
  or a device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
