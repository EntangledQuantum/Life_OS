<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Requested in context, never on first launch cold: the first time the user
      is about to rely on a reminder (§8.2). Denied is a supported state — the
      in-app pulse and the status strip still carry everything.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Alarms must survive a reboot. The OS drops every alarm on restart, so
      without this the app is silent from a restart until it is next opened,
      which on a phone that reboots overnight means silent all morning.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Exact alarms: declared, and deliberately only this one.

      `SCHEDULE_EXACT_ALARM` is granted at install on Android 12 and is a
      user-grantable special permission from 13, revocable at any time. The app
      checks `canScheduleExactAlarms()` per alarm and falls back to
      `setAndAllowWhileIdle`, which still escapes Doze but may be batched.

      `USE_EXACT_ALARM` — the one that cannot be revoked — is **not** declared
      and will not be: it is reserved by policy for alarm clocks and calendars,
      and a habit tracker claiming it is what gets an app flagged. See
      `notify/ReminderAlarms`.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Vibration is a channel property; without this the OS silently ignores it. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".LifeOsApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:forceDarkAllowed="false"
        tools:targetApi="29"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeOS">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LifeOS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              QR pairing deep link. `android:autoVerify` is impossible for an
              arbitrary user-chosen host — App Links need a verified domain and
              this instance may answer on 192.168.x.x — so the custom scheme is
              the only thing that can ever work, and it has to match exactly.

              The server mints `lifeos://pair?...` (apps/api/src/services/
              pairing.ts). This filter declared host "connect" and nothing else,
              so the link the QR actually contains matched no filter at all:
              scanning it in Google Lens or any camera offered nothing, and the
              whole point of the QR — the phone's own camera opening the app —
              was dead. `connect` is kept as an alias so older QRs still open.

              Host-less schemes do not match by scheme alone on Android, so
              every host the server can mint must be listed here.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lifeos" android:host="pair" />
                <data android:scheme="lifeos" android:host="connect" />
            </intent-filter>
        </activity>

        <!--
          WorkManager's default initialiser is kept; the queue drain worker is a
          plain CoroutineWorker so no custom factory is needed.
        -->

        <!-- ================= notifications (§8.1–§8.4) ================= -->

        <!--
          The alarm that says one reminder. Not exported: nothing outside this
          app has any business firing our reminders.
        -->
        <receiver
            android:name=".notify.AlarmReceiver"
            android:exported="false" />

        <!--
          Done / Snooze on the notification itself. `exported="false"` and the
          PendingIntents are immutable, so the actions cannot be re-targeted by
          another app.
        -->
        <receiver
            android:name=".notify.ActionReceiver"
            android:exported="false" />

        <!--
          Re-seed the alarms after a reboot, a timezone change, or an update of
          this app — all three clear what the OS was holding for us.
        -->
        <receiver
            android:name=".notify.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ===================== the widget (§8.5) ===================== -->

        <!--
          `exported="true"` is required: the launcher is a different process and
          has to be able to bind this. It is the one exported component besides
          the Activity, and it carries no data of its own — everything it draws
          comes from the app's own Room cache.
        -->
        <receiver
            android:name=".widget.LifeOsWidgetReceiver"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lifeos_widget_info" />
        </receiver>
    </application>
</manifest>
