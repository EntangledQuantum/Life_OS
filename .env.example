# API
API_PORT=8787
# 127.0.0.1 = this machine only (default, safest).
# 0.0.0.0   = reachable from your LAN — phones, tablets, a future native client.
#             Anyone on the same network can then reach the API, so keep
#             API_TOKEN secret and never port-forward this to the internet.
API_HOST=127.0.0.1
# Extra CORS origins, comma separated. Not needed for LAN: loopback and private
# addresses (10.x, 172.16-31.x, 192.168.x, *.local) are allowed automatically.
# CORS_ORIGINS=https://lifeos.example.com
# The ONLY credential. Every client — browser, agent, phone — sends this as
# `Authorization: Bearer <token>`. There is no username/password login.
#
# LEAVE THIS EMPTY. `pnpm setup` generates a strong token here, and the API
# generates one on boot if this is still empty or still a known weak value.
# There is deliberately no shipped default: a default would be the same
# password on every clone of this repo.
#
# To rotate it, blank this line and restart — you will get a new one, and every
# client will need it pasted in again.
API_TOKEN=

# Storage: local | supabase
STORAGE_MODE=local
DATABASE_PATH=./data/lifeos.db

# Optional Supabase (data storage only — no Supabase Auth)
# STORAGE_MODE=supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=your-service-or-anon-key

# Web
# Leave EMPTY. The dev server proxies /api to the API on the same origin, which
# is what lets a phone load the app over the LAN without extra configuration.
# Only set this if the API lives somewhere the web app cannot proxy to.
VITE_API_URL=
# Set to `localhost` to keep the web dev server on loopback only.
# WEB_HOST=localhost
# Dev convenience: skip the token prompt in the browser. Leave unset for any
# build you might serve to anyone else — it bakes the secret into the bundle.
# VITE_API_TOKEN=
